# Server-only — never commit real values. Create `.env.local` for local development.
GEMINI_API_KEY=

# Set to true or 1 to skip Gemini and use the labelled development mock generator.
USE_MOCK_BRIEF=

# Optional: single model for all requests (no automatic fallback). Example:
# GEMINI_MODEL=gemini-3.5-flash-lite
# Default when unset: gemini-3.5-flash-lite, 404-only fallback gemini-3.8-flash
# GEMINI_TIMEOUT_MS=90000

# Optional — provider comparison only (npm run benchmark:providers). Production stays on Gemini.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# BENCHMARK_GEMINI_MODEL=gemini-3.8-flash
# BENCHMARK_GROQ_MODEL=openai/gpt-oss-20b
# BENCHMARK_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# BENCHMARK_TIMEOUT_MS=90000

# Supabase — server only (Route Handlers). Never use NEXT_PUBLIC_ for service role.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Optional: set to false to skip persistence while testing Gemini
# SUPABASE_PERSISTENCE_ENABLED=true

# n8n follow-up — server only. Header x-clearpath-secret = N8N_WEBHOOK_SECRET
# Local production URL (workflow Active): http://localhost:5678/webhook/clearpath-lead
# Test URL (Listen for test event, workflow inactive): http://localhost:5678/webhook-test/clearpath-lead
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=
# N8N_TIMEOUT_MS=8000
